<%- include('partials/head', { title: 'New Message' }) %>
<h1>New Message</h1>
<form method="POST" action="/new">
  <input type="text" name="messageUser" placeholder="Your name" required>
  <input type="text" name="messageText" placeholder="Your message" required>
  <button type="submit">Send</button>
</form>
<p><a href="/">&larr; Back to messages</a></p>
</main>
</body>
</html>
