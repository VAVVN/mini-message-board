<%- include('partials/head', { title }) %>
<h1><%= title %></h1>
<a class="new-link" href="/new">Add a new message</a>
<ul>
  <% messages.forEach(msg => { %>
    <li>
      <strong><%= msg.user %></strong>: <%= msg.text %>
      <div class="meta">
        <%= msg.added.toLocaleString() %> &middot; <a href="/open">open</a>
      </div>
    </li>
  <% }) %>
</ul>
</main>
</body>
</html>
